{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/capital-engine?action=tick&cap=3", "schedule": "0 */6 * * *" }
  ],
  "functions": {
    "api/**": {
      "excludeFiles": "{assets/**,*.html,_*.js,*.json,scripts/**}",
      "includeFiles": "{api/protected-docs/**,api/helix_app/**,assets/data/companies/*.json,assets/data/capital-engine.json,assets/data/command-board-data.json,assets/data/companies-manifest.json,assets/data/empirical-gamma-by-phase.json,assets/data/stress-network-state.json,assets/data/bridge-patterns.json,assets/data/verbiage-templates.json,assets/data/corpus.json,assets/data/affiliate-config.json,assets/data/brain-connectome.json,assets/data/review-rubric.json,assets/data/_master-inbox.json}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/navigator", "destination": "/navigator.html" },
    { "source": "/aggregated", "destination": "/aggregated.html" },
    { "source": "/civilization", "destination": "/civilization.html" },
    { "source": "/kernel-comparison", "destination": "/kernel-comparison.html" },
    { "source": "/operator-guide", "destination": "/operator-guide.html" },
    { "source": "/my-documents", "destination": "/my-documents.html" },
    { "source": "/pattern-proposals", "destination": "/pattern-proposals.html" },
    { "source": "/vitals", "destination": "/vitals.html" },
    { "source": "/master-inbox", "destination": "/master-inbox.html" },
    { "source": "/treatment-discovery", "destination": "/treatment-discovery.html" },
    { "source": "/capital-engine", "destination": "/finance-capital-engine" },
    { "source": "/api/limen/(.*)", "destination": "/api/limen" }
  ],
  "redirects": [
    { "source": "/fractal-connectome", "destination": "/civilization", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/data/command-board-data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/(company-index|companies-manifest|company-registry|company-aliases).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/companies/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
