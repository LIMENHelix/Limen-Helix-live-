{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/limen-worker-ingest",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/limen-worker-snapshot",
      "schedule": "5,20,35,50 * * * *"
    },
    {
      "path": "/api/limen-worker-score",
      "schedule": "3,33 * * * *"
    },
    {
      "path": "/api/limen-worker-stress-refresh",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/brain-cognition-refresh",
      "schedule": "10,40 * * * *"
    },
    {
      "path": "/api/autopilot",
      "schedule": "7,37 * * * *"
    },
    {
      "path": "/api/feed-record",
      "schedule": "12 * * * *"
    },
    {
      "path": "/api/feed-resolve?emit=1",
      "schedule": "42 * * * *"
    },
    {
      "path": "/api/brain-weights-cron",
      "schedule": "47 * * * *"
    },
    {
      "path": "/api/social-cron?post=1",
      "schedule": "0 0,2,12,14,16,18,20,22 * * *"
    },
    {
      "path": "/api/subscriber-digest",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/hero-image",
      "schedule": "*/5 * * * *"
    }
  ],
  "functions": {
    "api/**": {
      "excludeFiles": "{assets/**,*.html,_*.js,*.json,scripts/**}",
      "includeFiles": "{api/protected-docs/**,api/helix_app/**,assets/data/*.json,assets/js/limen-plasticity.js,assets/js/limen-k4-selfconsistency.js}",
      "maxDuration": 800
    }
  },
  "rewrites": [
    {
      "source": "/sales-enrollments",
      "destination": "/sales-stage"
    },
    {
      "source": "/sales-referrals",
      "destination": "/sales-stage"
    },
    {
      "source": "/civilization",
      "destination": "/civilization.html"
    },
    {
      "source": "/kernel-comparison",
      "destination": "/kernel-comparison.html"
    },
    {
      "source": "/my-documents",
      "destination": "/my-documents.html"
    },
    {
      "source": "/pattern-proposals",
      "destination": "/pattern-proposals.html"
    },
    {
      "source": "/control",
      "destination": "/control.html"
    },
    {
      "source": "/flow",
      "destination": "/flow.html"
    },
    {
      "source": "/vitals",
      "destination": "/vitals.html"
    },
    {
      "source": "/treatment-discovery",
      "destination": "/treatment-discovery.html"
    },
    {
      "source": "/phase-map",
      "destination": "/phase-map.html"
    },
    {
      "source": "/relay-margin",
      "destination": "/relay-margin.html"
    },
    {
      "source": "/tech-watch",
      "destination": "/technology.html"
    },
    {
      "source": "/api/ddgs-search/(.*)",
      "destination": "/api/ddgs-search"
    },
    {
      "source": "/api/limen/(.*)",
      "destination": "/api/limen"
    }
  ],
  "redirects": [
    {
      "source": "/fractal-connectome",
      "destination": "/civilization",
      "statusCode": 301
    },
    {
      "source": "/capital-engine",
      "destination": "/finance-capital-engine",
      "statusCode": 308
    }
  ],
  "headers": [
    {
      "source": "/assets/data/command-board-data.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/data/(company-index|companies-manifest|company-registry|company-aliases).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/data/companies/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
