{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/limen-worker-ingest", "schedule": "*/15 * * * *" },
    { "path": "/api/limen-worker-snapshot", "schedule": "5,20,35,50 * * * *" },
    { "path": "/api/limen-worker-score", "schedule": "3,33 * * * *" },
    { "path": "/api/limen-worker-stress-refresh", "schedule": "0 * * * *" },
    { "path": "/api/brain-cognition-refresh", "schedule": "10,40 * * * *" }
  ],
  "functions": {
    "api/**": {
      "excludeFiles": "{assets/**,*.html,_*.js,*.json,scripts/**}",
      "includeFiles": "{api/protected-docs/**,api/helix_app/**,assets/data/*.json}",
      "maxDuration": 800
    }
  },
  "rewrites": [
    { "source": "/sales-appointments", "destination": "/sales-stage" },
    { "source": "/sales-shows", "destination": "/sales-stage" },
    { "source": "/sales-enrollments", "destination": "/sales-stage" },
    { "source": "/sales-referrals", "destination": "/sales-stage" },
    { "source": "/civilization", "destination": "/civilization.html" },
    { "source": "/kernel-comparison", "destination": "/kernel-comparison.html" },
    { "source": "/my-documents", "destination": "/my-documents.html" },
    { "source": "/pattern-proposals", "destination": "/pattern-proposals.html" },
    { "source": "/vitals", "destination": "/vitals.html" },
    { "source": "/treatment-discovery", "destination": "/treatment-discovery.html" },
    { "source": "/phase-map", "destination": "/phase-map.html" },
    { "source": "/relay-margin", "destination": "/relay-margin.html" },
    { "source": "/capital-engine", "destination": "/finance-capital-engine" },
    { "source": "/economy", "destination": "/domain-front?domain=economy" },
    { "source": "/environment", "destination": "/domain-front?domain=environment" },
    { "source": "/medicine", "destination": "/domain-front?domain=medicine" },
    { "source": "/technology", "destination": "/domain-front?domain=technology" },
    { "source": "/tech-watch", "destination": "/domain-front?domain=technology" },
    { "source": "/infrastructure", "destination": "/domain-front?domain=infrastructure" },
    { "source": "/science", "destination": "/domain-front?domain=science" },
    { "source": "/trade", "destination": "/domain-front?domain=trade" },
    { "source": "/governance", "destination": "/domain-front?domain=governance" },
    { "source": "/agriculture", "destination": "/domain-front?domain=agriculture" },
    { "source": "/industry", "destination": "/domain-front?domain=industry" },
    { "source": "/education", "destination": "/domain-front?domain=education" },
    { "source": "/communication", "destination": "/domain-front?domain=communication" },
    { "source": "/defense", "destination": "/domain-front?domain=defense" },
    { "source": "/religion", "destination": "/domain-front?domain=religion" },
    { "source": "/population", "destination": "/domain-front?domain=population" },
    { "source": "/law", "destination": "/domain-front?domain=law" },
    { "source": "/finance", "destination": "/domain-front?domain=finance" },
    { "source": "/intelligence", "destination": "/domain-front?domain=intelligence" },
    { "source": "/api/limen/(.*)", "destination": "/api/limen" }
  ],
  "redirects": [
    { "source": "/fractal-connectome", "destination": "/civilization", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/data/command-board-data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/(company-index|companies-manifest|company-registry|company-aliases).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/companies/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
