{
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    { "path": "/api/limen-worker-ingest", "schedule": "*/15 * * * *" },
    { "path": "/api/limen-worker-snapshot", "schedule": "5,20,35,50 * * * *" },
    { "path": "/api/limen-worker-stress-refresh", "schedule": "0 * * * *" },
    { "path": "/api/trigger-pattern-author", "schedule": "0 */6 * * *" },
    { "path": "/api/cron-rebuild-engine-outputs", "schedule": "30 */6 * * *" },
    { "path": "/api/cron-repair-held", "schedule": "0 3 * * *" }
  ],
  "functions": {
    "api/**": {
      "excludeFiles": "{assets/**,*.html,_*.js,*.json,scripts/**}",
      "includeFiles": "{api/protected-docs/**,api/helix_app/**,assets/data/*.json}",
      "maxDuration": 800
    }
  },
  "rewrites": [
    { "source": "/navigator", "destination": "/navigator.html" },
    { "source": "/aggregated", "destination": "/aggregated.html" },
    { "source": "/civilization", "destination": "/civilization.html" },
    { "source": "/kernel-comparison", "destination": "/kernel-comparison.html" },
    { "source": "/my-documents", "destination": "/my-documents.html" },
    { "source": "/pattern-proposals", "destination": "/pattern-proposals.html" },
    { "source": "/vitals", "destination": "/vitals.html" },
    { "source": "/treatment-discovery", "destination": "/treatment-discovery.html" },
    { "source": "/phase-map", "destination": "/phase-map.html" },
    { "source": "/capital-engine", "destination": "/finance-capital-engine" },
    { "source": "/api/limen/(.*)", "destination": "/api/limen" }
  ],
  "redirects": [
    { "source": "/fractal-connectome", "destination": "/civilization", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/assets/data/command-board-data.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/(company-index|companies-manifest|company-registry|company-aliases).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/data/companies/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
