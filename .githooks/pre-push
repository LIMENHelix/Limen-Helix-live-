#!/bin/sh
# Deploy gate for autonomous agent builds.
#
# main auto-deploys to production on Vercel. When a build runs under the agent
# (AGENT_BUILD=1), it must NOT push to main/master; it pushes a branch and a
# human merges to deploy. A human working normally (AGENT_BUILD unset) is not
# affected. Enable once with:  git config core.hooksPath .githooks
if [ "$AGENT_BUILD" = "1" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
      refs/heads/main|refs/heads/master)
        echo "" >&2
        echo "BLOCKED: agent build (AGENT_BUILD=1) may not push to $remote_ref." >&2
        echo "Push a branch (agent/<slug>) instead; a human merges it to deploy." >&2
        echo "" >&2
        exit 1
        ;;
    esac
  done
fi
exit 0
